# 1. Add your OpenAI API key
OPENAI_API_KEY=YOUR-KEY-HERE

# 2. Uncomment ONE of these base URLs based on your key type:

# For OpenAI Community Developer Program keys:
# OPENAI_BASE_URL=https://go.apis.huit.harvard.edu/ais-openai-direct-limited-schools/v1

# For HUIT Academic Technology keys:
# OPENAI_BASE_URL=https://go.apis.huit.harvard.edu/ais-openai-direct/v1